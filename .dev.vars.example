# .dev.vars.example
#
# Used by `wrangler dev` for local Cloudflare Worker secret injection.
# Copy to .dev.vars and fill in real values.
# .dev.vars is gitignored — NEVER commit real values here.
#
#   cp .dev.vars.example .dev.vars

# ── Cloudflare Worker Secrets ────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Shared guest/client token that gates /api/* routes. Must match the app's
# EXPO_PUBLIC_BACKEND_TOKEN when guest/unauthenticated backend access is used.
# Production is fail-closed. For intentionally token-less local development,
# set SEKRET_AUTH_MODE=dev-open explicitly instead of leaving security implicit.
SEKRET_CLIENT_TOKEN=
SEKRET_AUTH_MODE=required

# Optional: only for legacy HS256 Supabase projects. Leave blank for projects
# using asymmetric JWTs (the Worker verifies via the project JWKS instead).
SUPABASE_JWT_SECRET=

# Optional voice overrides for local testing only.
# Leave blank unless you intentionally map characters to custom voice IDs.
RAYLENE_VOICE_ID=
RYLANE_VOICE_ID=
CLOUD_VOICE_ID=
NIGHT_VOICE_ID=
SEKRET_VOICE_ID=
PARENT_COACH_VOICE_ID=

# Supabase safety-scan secrets do NOT go in .dev.vars for the Worker.
# Set those on Supabase instead:
#   supabase secrets set SAFETY_SCAN_SECRET=...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set OPENAI_API_KEY=...
