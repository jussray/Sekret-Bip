# ── Secrets — NEVER commit these ─────────────────────────────────────────
.env
.env.local
.env.*.local
.dev.vars

# ── MCP config (may contain project refs / tokens) ────────────────────────
.mcp.json

# ── Expo / React Native ───────────────────────────────────────────────────
node_modules/
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ── Browser test artifacts ────────────────────────────────────────────────
playwright-report/
test-results/

# ── CI script output / evidence artifacts ────────────────────────────────
artifacts/

# ── Per-run test-skip snapshots (regenerated every run; the dated/durable
# ── founder-operator reports and latest.json/latest.md are intentionally
# ── committed and must stay tracked) ──────────────────────────────────────
reports/control-room/*test-skips-latest.json

# ── Generated build outputs (regenerated by their own scripts/tests) ─────
assets/generated/

# ── Native build outputs ──────────────────────────────────────────────────
android/
ios/

# ── Wrangler local state ──────────────────────────────────────────────────
.wrangler/

# ── Supabase CLI local state ──────────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ── Design artifacts — store in Figma / Notion, not git ──────────────────
figma/
design-references/

# ── Archived / duplicate binary assets ───────────────────────────────────
# UUID-named PNGs in assets/images/ are duplicates of named files.
# Run the BFG cleanup in docs/REPO_HYGIENE.md to purge from history.
assets/images/archive/

# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
*.pem

# ── Editor ────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
