# ── Secrets — NEVER commit these ─────────────────────────────────────────
.env
.env.local
.env.*.local
.dev.vars

# ── MCP config (may contain project refs / tokens) ────────────────────────
.mcp.json

# ── Expo / React Native ───────────────────────────────────────────────────
node_modules/
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ── Browser test artifacts ────────────────────────────────────────────────
playwright-report/
test-results/

# ── Local script-run evidence (EVIDENCE_PATH defaults) ────────────────────
artifacts/

# ── Native build outputs ──────────────────────────────────────────────────
android/
ios/

# ── Wrangler local state ──────────────────────────────────────────────────
.wrangler/

# ── Supabase CLI local state ──────────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ── Design artifacts — store in Figma / Notion, not git ──────────────────
figma/
design-references/

# ── Archived / duplicate binary assets ───────────────────────────────────
# UUID-named PNGs in assets/images/ are duplicates of named files.
# Run the BFG cleanup in docs/REPO_HYGIENE.md to purge from history.
assets/images/archive/

# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
*.pem

# ── Editor ────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
