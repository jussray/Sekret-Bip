{
  "name": "sekret-bip",
  "version": "1.0.0",
  "description": "A private emotional wellness and self-expression app built with React Native and Expo.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "vercel-build": "expo export -p web",
    "test": "node --test",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "audit:runtime-assets": "node scripts/audit-runtime-assets.mjs",
    "verify:room-archives": "node scripts/verify-room-archives.js",
    "verify:bundle": "npx expo export --platform web --clear",
    "verify:prepush": "npm run audit:runtime-assets && npm run type-check && npm run lint && npm run verify:bundle && npm run verify:room-archives",
    "test:oracle": "node scripts/test-oracle-discovery.mjs",
    "test:voice-intelligence": "node scripts/test-voice-intelligence.mjs",
    "deploy": "npm run vercel-build && wrangler deploy",
    "preview": "npm run vercel-build && wrangler dev"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "2.74.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.9",
    "expo-haptics": "~13.0.1",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^7.1.2",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.61.0",
    "wrangler": "^4.151.2"
  }
}
