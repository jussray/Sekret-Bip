{
  "name": "sekret-bip",
  "version": "1.0.0",
  "description": "A private emotional wellness and self-expression app built with React Native and Expo.",
  "main": "expo-router/entry",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && node scripts/write-release-metadata.mjs dist",
    "vercel-build": "npm run build:web",
    "test": "node scripts/run-unit-tests.mjs",
    "test:human-ai-contract": "node --test test/human-ai-doc-contract.test.mjs test/human-ai-runtime-precedence.test.mjs test/openai-prompt-injection.test.mjs",
    "test:control-room-core": "node --test test/control-room-core-contract.test.mjs test/control-room-server-process-tree.test.mjs test/control-room-verify-frontend.test.mjs test/control-room-github-route.test.mjs test/control-room-os.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:live-onboarding-email": "playwright test --config=playwright.production.config.ts e2e/live-onboarding-email.spec.ts",
    "test:controlled-alpha": "node --test test/controlled-alpha-activation.test.mjs test/controlled-alpha-founder-room-plan.test.mjs test/controlled-alpha-service-boundaries.test.mjs test/controlled-alpha-crew-access-hardening.test.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "typecheck": "npm run type-check",
    "verify:mcp": "node scripts/verify-mcp-config.mjs",
    "verify:cookies": "node scripts/verify-cookie-contract.mjs",
    "verify:implementation-ledger": "node scripts/verify-implementation-ledger.mjs",
    "audit:runtime-assets": "node scripts/audit-runtime-assets.mjs",
    "audit:control-room:structure": "node scripts/control-room-structural-scan.mjs",
    "audit:control-room:rls": "node scripts/control-room-rls-scan.mjs",
    "audit:control-room": "npm run audit:control-room:structure && npm run audit:control-room:rls",
    "audit:control-room:ingest": "node scripts/control-room-ingest-scans.mjs",
    "audit:control-room:advisors": "node scripts/control-room-ingest-supabase-advisors.mjs",
    "audit:control-room:local-report": "node scripts/control-room-ingest-local-report.mjs",
    "audit:companion-lab": "node scripts/companion-lab-audit.js",
    "audit:companion-lab:verbose": "node scripts/companion-lab-audit.js --verbose",
    "validate:companions": "node scripts/validate-companion-assets.mjs",
    "verify:room-archives": "node scripts/verify-room-archives.js",
    "verify:bundle": "npx expo export --platform web --clear && node scripts/write-release-metadata.mjs dist",
    "verify:worker:alpha": "wrangler deploy --config wrangler.alpha.toml --dry-run",
    "verify:controlled-alpha": "npm run test:controlled-alpha && npm run verify:worker:alpha",
    "verify:local": "node scripts/control-room-local.js",
    "verify:local:ingest": "npm run verify:local; CONTROL_ROOM_INGEST=1 npm run audit:control-room:local-report",
    "verify:cloudflare-native": "node scripts/verify-cloudflare-native-deploy.mjs",
    "verify:production-deploy-branch": "node scripts/assert-production-deploy-branch.mjs",
    "verify:production-release": "node scripts/verify-production-release.mjs",
    "verify:prepush": "npm run verify:mcp && npm run verify:cookies && npm run verify:implementation-ledger && npm run audit:runtime-assets && npm run audit:control-room && npm run validate:companions && npm run test:control-room-core && npm run test:founder-operator && npm run test:github-failure-routing && npm test && npm run type-check && npm run lint && npm run verify:bundle && npm run verify:room-archives",
    "test:device-sync": "node --test scripts/test-device-sync.mjs",
    "test:oracle": "node scripts/test-oracle-discovery.mjs",
    "test:voice-intelligence": "node scripts/test-voice-intelligence.mjs",
    "deploy:web:preview": "SEKRET_RELEASE_ENVIRONMENT=preview npm run build:web && wrangler pages deploy dist --project-name sekret-bip",
    "deploy:web:production": "node scripts/assert-production-deploy-branch.mjs && SEKRET_RELEASE_ENVIRONMENT=production SEKRET_CANONICAL_URL=https://sekretbip.net npm run build:web && wrangler pages deploy dist --project-name sekret-bip --branch main",
    "deploy:pages": "npm run deploy:web:preview",
    "deploy:api:production": "node scripts/assert-production-deploy-branch.mjs && node scripts/deploy-cloudflare-worker.mjs",
    "deploy:worker": "npm run deploy:api:production",
    "deploy:worker:alpha": "wrangler deploy --config wrangler.alpha.toml",
    "deploy:cloudflare": "npm run deploy:api:production",
    "preview:worker": "wrangler dev",
    "preview:worker:alpha": "wrangler dev --config wrangler.alpha.toml",
    "control-room:agent": "node scripts/control-room-agent.mjs",
    "control-room:dev": "node scripts/control-room-dev.mjs",
    "control-room:serve": "node scripts/control-room-server.mjs",
    "control-room:github-status": "node scripts/control-room-github-route.mjs --json",
    "control-room:github-route": "node scripts/control-room-github-route.mjs --ensure --fetch",
    "control-room:mission:continue-yesterday": "node scripts/control-room-agent.mjs continue-yesterday",
    "control-room:mission:launch-bip": "node scripts/control-room-agent.mjs launch-bip",
    "control-room:mission:verify-local": "node scripts/control-room-agent.mjs verify-local",
    "control-room:mission:verify-frontend": "node scripts/control-room-agent.mjs verify-frontend",
    "test:contract:supabase-worker": "node --test test/supabase-worker-ai-reply-contract.test.mjs",
    "test:founder-operator": "node --test test/control-room-founder-operator-contract.test.mjs test/control-room-founder-operator-server.test.mjs test/control-room-founder-operator.test.mjs",
    "control-room:github-failures:scan": "node scripts/control-room-ingest-github-failures.mjs",
    "control-room:github-failures:ingest": "CONTROL_ROOM_GITHUB_INGEST=1 node scripts/control-room-ingest-github-failures.mjs",
    "test:github-failure-routing": "node --test test/control-room-github-failure-routing.test.mjs",
    "configure:mcp:codex-cloudflare": "node scripts/configure-codex-cloudflare-mcp.mjs"
  },
  "dependencies": {
    "@expo/log-box": "^56.0.13",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.74.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "^56.0.12",
    "expo-av": "~16.0.8",
    "expo-constants": "^56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.18",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "^56.0.14",
    "expo-modules-core": "~56.0.17",
    "expo-notifications": "^56.0.18",
    "expo-router": "^56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "jose": "^6.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.8.3",
    "react-server-dom-webpack": "~19.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "^1.61.1",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.62.1",
    "wrangler": "^4.100.0"
  },
  "optionalDependencies": {
    "node-addon-api": "^8.8.0",
    "sharp": "^0.35.2"
  }
}
