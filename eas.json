{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "teen",
        "EXPO_PUBLIC_APP_VARIANT": "teen",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.sekretbip.net"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    },
    "parent-development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "parent",
        "EXPO_PUBLIC_APP_VARIANT": "parent",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.sekretbip.net"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "teen",
        "EXPO_PUBLIC_APP_VARIANT": "teen",
        "EXPO_PUBLIC_RELEASE_AUDIENCE": "beta",
        "EXPO_PUBLIC_BACKEND_URL": "https://sekret-backend-alpha.mcgill-raylene.workers.dev"
      }
    },
    "parent-preview": {
      "distribution": "internal",
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "parent",
        "EXPO_PUBLIC_APP_VARIANT": "parent",
        "EXPO_PUBLIC_RELEASE_AUDIENCE": "beta",
        "EXPO_PUBLIC_BACKEND_URL": "https://sekret-backend-alpha.mcgill-raylene.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "teen",
        "EXPO_PUBLIC_APP_VARIANT": "teen",
        "EXPO_PUBLIC_RELEASE_AUDIENCE": "public",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.sekretbip.net"
      }
    },
    "parent-production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "parent",
        "EXPO_PUBLIC_APP_VARIANT": "parent",
        "EXPO_PUBLIC_RELEASE_AUDIENCE": "public",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.sekretbip.net"
      }
    }
  }
}
