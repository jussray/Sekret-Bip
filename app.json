{
  "expo": {
    "name": "Se'kret Bip",
    "slug": "sekret-bip",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sekret",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#160028"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sekretbip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#160028"
      },
      "package": "com.sekretbip.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
