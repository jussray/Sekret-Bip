{
  "expo": {
    "name": "Se'kret Bip",
    "slug": "sekret-bip",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sekret",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sekretbip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#160028"
      },
      "package": "com.sekretbip.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
