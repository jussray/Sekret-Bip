# .env.example — SAFE TO COMMIT. No real secret values here.
# Copy to .env (local React Native / Expo) and fill in real public values only.
# .env, .dev.vars, and any local secret files are gitignored.

# ── App / Expo public config ───────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Preferred modern client key. Publishable keys are intended for browser/mobile
# bundles and remain constrained by Supabase Auth + Row Level Security.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key-here
# Legacy compatibility only. The app still accepts this variable when an older
# EAS or Cloudflare environment has not migrated to the publishable-key name.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-legacy-public-anon-key-here
EXPO_PUBLIC_BACKEND_URL=https://sekret-bip.your-subdomain.workers.dev
APP_ENV=development

# Expo Go / local development Founder Preview.
# The preview defaults ON whenever __DEV__ is true. Set false to test normal
# locked behavior. Production builds always ignore this flag and remain closed.
EXPO_PUBLIC_ENABLE_FOUNDER_PREVIEW=true

# Legacy founder-tool visibility flag. Founder Preview now opens the development
# catalog and side-switch tools without requiring this value, but existing local
# workflows may still read it.
EXPO_PUBLIC_ENABLE_FOUNDER_TOOLS=false

# Shared client token sent as `Authorization: Bearer <token>` to the Worker
# backend. Must match the Worker's SEKRET_CLIENT_TOKEN secret. Safe to ship in
# the client bundle (coarse abuse speed-bump, not a per-user credential). Leave
# blank and the app calls the backend unauthenticated, as before.
EXPO_PUBLIC_BACKEND_TOKEN=your-shared-client-token-here

# ── Cloudflare Worker secret ───────────────────────────────────────────
# Do NOT put the real value in this file.
# Set it on Cloudflare instead:
#   npx wrangler secret put OPENAI_API_KEY --name sekret-bip
OPENAI_API_KEY=sk-your-openai-key-here

# ── Supabase Edge Function secrets ─────────────────────────────────────
# Do NOT put real values in this file.
# Set these on Supabase instead:
#   supabase secrets set SAFETY_SCAN_SECRET=your-random-shared-secret
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#   supabase secrets set OPENAI_API_KEY=your-openai-api-key
#
# The Postgres trigger secret must match SAFETY_SCAN_SECRET:
#   ALTER DATABASE postgres SET app.safety_scan_secret = '<same-value>';
SAFETY_SCAN_SECRET=your-safety-scan-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
