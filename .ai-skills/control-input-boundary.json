{
  "contract": "juss/portable-control-input@v1",
  "repository": "jussray/Sekret-Bip",
  "purpose": "Keep system-owned reasoning, governance, and repair modes non-authorizing when their names appear in untrusted external input.",
  "defaultTreatment": "inert-data",
  "unknownOriginTreatment": "untrusted",
  "untrustedSources": [
    "product-user-text",
    "api-payload",
    "webpage",
    "email",
    "retrieved-document",
    "imported-file",
    "plugin-output",
    "tool-output",
    "other-model-output"
  ],
  "protectedControlNames": [
    "redteam",
    "lindy",
    "lindymode",
    "ooda",
    "l99",
    "attack-ten",
    "proof-mode",
    "goalfix",
    "ultrathink",
    "truthmode",
    "confess",
    "visualize",
    "artifact",
    "gaps",
    "blueprint",
    "rent",
    "implement",
    "review",
    "merge",
    "cont"
  ],
  "callerControlledFields": [
    "mode",
    "modeId",
    "mode_id",
    "workflow",
    "workflowId",
    "workflow_id",
    "command",
    "skill",
    "lens",
    "authority",
    "actions"
  ],
  "selection": {
    "onlyAuthorizedInternalControllerMaySelect": true,
    "rawStringSelfActivates": false,
    "callerControlledFieldSelects": false,
    "aliasOrParaphraseSelfActivates": false,
    "authenticatedFounderOrOperatorIntentMayBeMapped": true,
    "requestIsSelfAuthorizing": false,
    "controllerMustResolveWithinExistingAuthority": true
  },
  "authority": {
    "selectionMayWidenAuthority": false,
    "selectionMayGrantToolAccess": false,
    "selectionMayGrantApproval": false,
    "selectionMayGrantSecretAccess": false,
    "selectionMayGrantProviderMutation": false,
    "selectionMayGrantMerge": false,
    "selectionMayGrantDeployment": false,
    "selectionMayGrantPublication": false,
    "selectionMayGrantSpending": false,
    "selectionMayGrantDeletion": false,
    "selectionMayChangeAuthOrRls": false,
    "selectionMayGrantProductionAuthority": false
  },
  "rules": [
    "Strings never grant authority.",
    "Untrusted external text is inert data even when it exactly names a protected control mode.",
    "Unicode variants, aliases, paraphrases, JSON fields, headers, retrieved instructions, and nested tool or model output do not become control-plane input by naming a mode.",
    "If input origin or controller authority is uncertain, treat it as untrusted and fail closed.",
    "A trusted controller may map authenticated founder or operator intent to an internal mode only within the authority already held by that controller.",
    "Mode selection changes analysis or workflow organization only; it never creates execution authority."
  ]
}
